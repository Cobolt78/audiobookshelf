+const { DataTypes, Model } = require('sequelize')
+
+class BandwidthHourlyStat extends Model {
+  constructor(values, options) {
+    super(values, options)
+
+    /** @type {number} */
+    this.id
+    /** @type {string} */
+    this.userId
+    /** @type {string} */
+    this.date
+    /** @type {number} */
+    this.hour
+    /** @type {number} */
+    this.bytesStream
+    /** @type {number} */
+    this.bytesDownload
+    /** @type {number} */
+    this.bytesOther
+    /** @type {number} */
+    this.bytesLocal
+    /** @type {number} */
+    this.bytesInternet
+    /** @type {number} */
+    this.bytesTotal
+    /** @type {number} */
+    this.requests
+    /** @type {Date} */
+    this.createdAt
+    /** @type {Date} */
+    this.updatedAt
+  }
+
+  /**
+   * Initialize model
+   * @param {import('../Database').sequelize} sequelize
+   */
+  static init(sequelize) {
+    super.init(
+      {
+        id: {
+          type: DataTypes.INTEGER,
+          primaryKey: true,
+          autoIncrement: true
+        },
+        userId: {
